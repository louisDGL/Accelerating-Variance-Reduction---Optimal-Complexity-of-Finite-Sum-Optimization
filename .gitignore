# Result caches: only the small, costly ones are versioned; the others are rebuilt by their script
results/*.pkl
!results/A3.pkl
!results/A4.pkl
!results/A4b.pkl
!results/B2.pkl
!results/GammaDelta.pkl
!results/validation_book.pkl
results/*_quick*
# Muon result caches: the caches committed before 2026-11-20 stay versioned; the later ones (M5b, M9, M9b, about 290 MB)
# are rebuilt by their scripts, except the small cache read by figure 4 of the paper
muon/results/*.pkl
!muon/results/M9_law.pkl
muon/results/*_quick*
results/log_*.txt
figures/*_quick.*

